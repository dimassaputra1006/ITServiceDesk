<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" styleClass="workstation-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.itservicedesk.controller.TicketController">

    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="status-bar">
                <padding>
                    <Insets bottom="10" left="20" right="20" top="10" />
                </padding>
                <children>
                    <HBox spacing="10.0">
                        <Button text="TICKET DASHBOARD" styleClass="nav-button" />
                        <Button text="USER DIRECTORY" onAction="#handleUserNav" styleClass="nav-button" />
                    </HBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <HBox alignment="CENTER" spacing="24">
                        <VBox alignment="CENTER" spacing="2">
                            <Label styleClass="telemetry-label" text="QUEUE" />
                            <Label fx:id="lblQueueCount" styleClass="telemetry-value" text="0" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="2">
                            <Label styleClass="telemetry-label" text="ACTIVE" />
                            <Label fx:id="lblActiveCount" styleClass="telemetry-value-active" text="0" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="2">
                            <Label styleClass="telemetry-label" text="RESOLVED" />
                            <Label fx:id="lblResolvedCount" styleClass="telemetry-value" text="0" />
                        </VBox>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label fx:id="lblAnalystName" styleClass="analyst-name" text="ANALYST: ---" />
                        <Label fx:id="lblShiftStatus" styleClass="analyst-status" text="STATUS: ON SHIFT" />
                    </VBox>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="toolbar">
                <padding>
                    <Insets bottom="8" left="20" right="20" top="8" />
                </padding>
                <children>
                    <ComboBox fx:id="cbAnalyst" prefWidth="220" promptText="Select Analyst" styleClass="filter-combo" />
                    <TextField fx:id="txtSearch" prefWidth="260" promptText="Search ticket..." styleClass="search-field" />
                    <ComboBox fx:id="cbFilterPriority" prefWidth="160" promptText="All Priorities" styleClass="filter-combo" />
                    <Button fx:id="btnNewTicket" styleClass="toolbar-button" text="+ NEW TICKET" />
                    <Button fx:id="btnRefresh" styleClass="toolbar-button" text="↻ REFRESH" />
                </children>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.35, 0.75" styleClass="workstation-split">
            <!-- Ticket Queue -->
            <VBox styleClass="panel queue-panel">
                <padding>
                    <Insets bottom="16" left="16" right="16" top="16" />
                </padding>
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label styleClass="panel-bracket" text="[" />
                        <Label styleClass="panel-title" text="TICKET QUEUE" />
                        <Label styleClass="panel-bracket" text="]" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblQueueHint" styleClass="panel-hint" text="AWAITING TRIAGE" />
                    </HBox>

                    <Separator styleClass="panel-separator" />

                    <ScrollPane fitToWidth="true" styleClass="panel-scroll" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="queueContainer" spacing="8" />
                        </content>
                    </ScrollPane>
                </children>
            </VBox>

            <!-- Active Room -->
            <VBox styleClass="panel active-panel">
                <padding>
                    <Insets bottom="16" left="16" right="16" top="16" />
                </padding>
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label styleClass="panel-bracket" text="[" />
                        <Label styleClass="panel-title" text="ACTIVE ROOM" />
                        <Label styleClass="panel-bracket" text="]" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblActiveHint" styleClass="panel-hint" text="NO SESSION" />
                    </HBox>

                    <Separator styleClass="panel-separator" />

                    <VBox fx:id="activeRoomContainer" spacing="12" VBox.vgrow="ALWAYS" />
                </children>
            </VBox>

            <!-- System Feed -->
            <VBox styleClass="panel active-panel">
                <padding>
                    <Insets bottom="16" left="16" right="16" top="16" />
                </padding>
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label styleClass="panel-bracket" text="[" />
                        <Label styleClass="panel-title" text="SYSTEM FEED" />
                        <Label styleClass="panel-bracket" text="]" />
                    </HBox>
                    <Separator styleClass="panel-separator" />
                    <VBox fx:id="historyContainer" spacing="8" />
                    <Separator styleClass="panel-separator" />
                    <Label styleClass="active-label" text="RECENT ACTIVITY" />
                    <VBox fx:id="logContainer" spacing="6" VBox.vgrow="ALWAYS" />
                </children>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
