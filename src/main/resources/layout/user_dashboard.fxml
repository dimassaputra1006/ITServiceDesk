<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="650" prefWidth="1000" styleClass="workstation-root" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.itservicedesk.controller.UserController">

    <top>
        <VBox spacing="0">
            <children>
                <!-- Top nav bar — same role as status-bar on the ticket dashboard -->
                <HBox alignment="CENTER_LEFT" spacing="20" styleClass="status-bar">
                    <padding>
                        <Insets bottom="10" left="20" right="20" top="10" />
                    </padding>
                    <children>
                        <HBox spacing="10">
                            <Button onAction="#handleDashboardNav" styleClass="nav-button" text="TICKET DASHBOARD" />
                            <Button styleClass="nav-button, nav-button-active" text="USER DIRECTORY" />
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label fx:id="lblAnalystName" styleClass="analyst-name" text="ANALYST: ---" />
                        <Label fx:id="lblShiftStatus" styleClass="analyst-status" text="STATUS: ON SHIFT" />
                    </VBox>
                    </children>
                </HBox>

                <!-- Toolbar row — search + primary action, mirrors ticket dashboard's toolbar -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="toolbar">
                    <padding>
                        <Insets bottom="8" left="20" right="20" top="8" />
                    </padding>
                    <children>
                        <TextField fx:id="searchField" prefWidth="250" promptText="Search employee..." styleClass="search-field" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnAddUser" onAction="#handleAddUser" styleClass="toolbar-button, toolbar-button-primary" text="+ ADD USER" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <VBox styleClass="panel, directory-panel">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16" />
            </padding>
            <children>
                <TableView fx:id="userTable" styleClass="user-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="nameCol" prefWidth="400" text="Employee Name" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>

    <right>
        <VBox alignment="TOP_CENTER" prefWidth="350" spacing="0" styleClass="panel, profile-panel">
            <padding>
                <Insets bottom="20" left="18" right="18" top="24" />
            </padding>
            <children>
                <!-- Header: avatar + name + email, like the Directory profile header -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <Circle fx:id="profileAvatar" radius="30" strokeType="INSIDE" styleClass="avatar-placeholder" />
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lblProfileName" styleClass="profile-name" text="Select Employee" />
                                <Label fx:id="lblProfileEmail" styleClass="profile-email" text="-" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets top="18" />
                    </VBox.margin>
                    <children>
                        <!-- Identity section -->
                        <Label styleClass="section-title" text="IDENTITY" />
                        <GridPane hgap="18" vgap="12">
                            <VBox.margin>
                                <Insets bottom="16" top="10" />
                            </VBox.margin>
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50" />
                                <ColumnConstraints percentWidth="50" />
                            </columnConstraints>
                            <children>
                                <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label styleClass="field-label" text="Username" />
                                    <Label fx:id="lblProfileUsername" styleClass="field-value" text="-" />
                                </VBox>
                                <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label styleClass="field-label" text="Employee ID" />
                                    <Label fx:id="lblProfileEmployeeId" styleClass="field-value" text="-" />
                                </VBox>
                                <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                    <Label styleClass="field-label" text="Phone" />
                                    <Label fx:id="lblProfilePhone" styleClass="field-value" text="-" />
                                </VBox>
                            </children>
                        </GridPane>

                        <Separator styleClass="profile-divider" />

                        <!-- Organization section -->
                        <Label styleClass="section-title" text="ORGANIZATION" />
                        <GridPane hgap="18" vgap="12">
                            <VBox.margin>
                                <Insets bottom="16" top="10" />
                            </VBox.margin>
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50" />
                                <ColumnConstraints percentWidth="50" />
                            </columnConstraints>
                            <children>
                                <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label styleClass="field-label" text="Role" />
                                    <ComboBox fx:id="cbProfileRole" maxWidth="Infinity" styleClass="search-field" />
                                </VBox>
                                <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label styleClass="field-label" text="Department" />
                                    <ComboBox fx:id="cbProfileDept" editable="true" maxWidth="Infinity" styleClass="search-field" />
                                </VBox>
                                <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label styleClass="field-label" text="Account Status" />
                                    <Label fx:id="lblAccountStatus" styleClass="field-value" text="-" />
                                </VBox>
                                <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label styleClass="field-label" text="Last Login" />
                                    <Label fx:id="lblProfileLastLogin" styleClass="field-value" text="-" />
                                </VBox>
                                <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                                    <Label styleClass="field-label" text="Member Since" />
                                    <Label fx:id="lblProfileCreatedAt" styleClass="field-value" text="-" />
                                </VBox>
                            </children>
                        </GridPane>

                        <Separator styleClass="profile-divider" />

                        <!-- Device section -->
                        <Label styleClass="section-title" text="DEVICE" />
                        <VBox spacing="2">
                            <VBox.margin>
                                <Insets bottom="8" top="10" />
                            </VBox.margin>
                            <children>
                                <Label styleClass="field-label" text="Assigned Device" />
                                <Label fx:id="lblProfileDevice" styleClass="field-value" text="No data yet." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <Button fx:id="btnSaveChanges" maxWidth="Infinity" onAction="#handleSaveChanges" styleClass="toolbar-button, toolbar-button-primary" text="SAVE CHANGES" />

                <HBox alignment="CENTER" spacing="8">
                    <VBox.margin>
                        <Insets top="8" />
                    </VBox.margin>
                    <children>
                        <Button fx:id="btnLockUser" onAction="#handleLockUser" styleClass="toolbar-button" text="LOCK" />
                        <Button fx:id="btnUnlockUser" onAction="#handleUnlockUser" styleClass="toolbar-button" text="UNLOCK" />
                        <Button fx:id="btnDeleteUser" onAction="#handleDeleteUser" styleClass="toolbar-button, btn-close" text="DELETE" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </right>
</BorderPane>
