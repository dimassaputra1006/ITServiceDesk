<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" stylesheets="@css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.itservicedesk.controller.UserController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <HBox spacing="10.0">
                    <Button onAction="#handleDashboardNav" styleClass="nav-button" text="TIKET DASHBOARD" />
                    <Button styleClass="nav-button" text="USER DIRECTORY" />
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" prefWidth="250.0" promptText="Cari karyawan..." style="-fx-background-radius: 15;" />
                <Button fx:id="btnAddUser" onAction="#handleAddUser" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 15;" text="+ Tambah User" />
            </children>
        </HBox>
    </top>

    <center>
        <VBox BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="10.0" top="15.0" />
            </padding>
            <children>
                <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="nameCol" prefWidth="400.0" text="Nama Karyawan" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>

    <right>
        <VBox alignment="TOP_CENTER" prefWidth="350.0" spacing="15.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" top="30.0" />
            </padding>
            <children>
                <Circle fill="#e0e0e0" radius="50.0" stroke="TRANSPARENT" strokeType="INSIDE" />
                <Label fx:id="lblProfileName" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Pilih Karyawan" />

                <TabPane prefHeight="400.0" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="Tentang &amp; Departemen">
                            <content>
                                <AnchorPane minHeight="0.0" minWidth="0.0">
                                    <children>
                                        <VBox layoutX="20.0" layoutY="20.0" prefHeight="175.0" prefWidth="153.0" spacing="10.0">
                                            <children>
                                                <Label style="-fx-font-weight: bold;" text="Departemen:" />
                                                <Label fx:id="lblProfileDept" text="-" />
                                                <Label style="-fx-font-weight: bold;" text="Email:" />
                                                <Label fx:id="lblProfileEmail" text="-" />
                                    <Label style="-fx-font-weight: bold;" text="Phone:" />
                                    <Label fx:id="lblProfilePhone" text="-" />
                                            </children>
                                        </VBox>
                                    </children>
                                </AnchorPane>
                            </content>
                        </Tab>

                        <Tab text="Perangkat Aktif">
                            <content>
                                <AnchorPane minHeight="0.0" minWidth="0.0">
                                    <children>
                                        <VBox layoutX="20.0" layoutY="20.0" prefHeight="46.0" prefWidth="318.0" spacing="10.0">
                                            <children>
                                                <Label style="-fx-font-weight: bold;" text="Laptop / PC:" />
                                                <Label fx:id="lblProfileDevice" text="Belum ada data." wrapText="true" />
                                            </children>
                                        </VBox>
                                    </children>
                                </AnchorPane>
                            </content>
                        </Tab>
                    </tabs>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </TabPane>
            </children>
        </VBox>
    </right>
</BorderPane>
